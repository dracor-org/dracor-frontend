# Deterministic config for Vitest. Loaded for mode `test` and takes priority
# over a developer's `.env.local`, so route tests don't depend on whatever
# optional features happen to be enabled locally.
VITE_DRACOR_API=/api/v1
VITE_SITEMAP_URL=
VITE_WITH_SPARQL=
VITE_DRACOR_LEGACY_API=
VITE_WITH_RAHTZ_PRIZE=
VITE_DRACOR_GUIDELINES=https://guidelines.invalid/
VITE_SPARQL_URL=https://sparql.invalid/
VITE_EZLINAVIS_URL=https://ezlinavis.invalid/
